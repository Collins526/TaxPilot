# PostgreSQL
POSTGRES_DB=taxpilot
POSTGRES_USER=taxpilot
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Backend
SPRING_PROFILES_ACTIVE=prod
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=prefer
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]

# Initial system administrator (required only when the database has no admin).
# Generate a unique secret password of at least 12 characters; never commit .env.
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PHONE=+254700000000
BOOTSTRAP_ADMIN_PASSWORD=

# Redis (token revocation / refresh blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379

# Document storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI assistant (OpenAI-compatible). Explanation only; never calculates tax.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend
API_BASE_URL=http://localhost:8080
